<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>差异管理 - 对账中心</title>
    <script src="common/tailwind.js"></script>
    <script src="common/lucide.min.js"></script>
    <link rel="stylesheet" href="common/styles.css">
    <script>
        tailwind.config = { theme: { extend: { colors: { primary: '#003eb3', secondary: '#e6f0ff' } } } };
    </script>
</head>
<body class="bg-gray-50">
    <div class="flex min-h-screen">
        <div id="sidebar-container"></div>
        <main class="flex-1 ml-64 p-6">
            <!-- 页头 -->
            <div class="bg-white rounded-lg shadow-sm p-6 mb-6">
                <h1 class="text-xl font-bold text-gray-800">差异管理</h1>
                <p class="text-sm text-gray-500 mt-1">集中暴露对账未平项。强校验差异（STRICT）阻断结账须闭环处理；提示差异（WARN）仅标记跟踪。对账中心不生成业务单据，支持按责任人路由、认领、跟进备注、退回来源系统修正与忽略。</p>
            </div>

            <!-- 差异列表卡片 -->
            <div class="bg-white rounded-lg shadow-sm p-6">
                <!-- 统一筛选组件 -->
                <div class="flex items-center gap-3 mb-4 flex-wrap">
                    <div class="flex items-center border border-gray-300 rounded-md overflow-hidden">
                        <select id="filter-select" class="px-3 py-2 bg-gray-50 border-r border-gray-300 text-sm outline-none">
                            <option value="diffNo">差异编号</option>
                            <option value="ruleNo">规则编号</option>
                            <option value="scene">对账场景</option>
                            <option value="owner">责任人</option>
                        </select>
                        <input id="filter-input" type="text" placeholder="请输入差异编号" class="px-3 py-2 text-sm outline-none w-64">
                    </div>
                    <button class="px-4 py-2 bg-primary text-white rounded-md hover:bg-blue-700 text-sm flex items-center"><i data-lucide="search" class="w-4 h-4 mr-1"></i>搜索</button>
                    <button class="px-4 py-2 bg-gray-100 border border-gray-300 rounded-md hover:bg-gray-200 text-sm flex items-center"><i data-lucide="rotate-ccw" class="w-4 h-4 mr-1"></i>刷新</button>
                    <button id="advanced-filter-btn" class="px-4 py-2 bg-gray-100 border border-gray-300 rounded-md hover:bg-gray-200 text-sm flex items-center"><i data-lucide="sliders-horizontal" class="w-4 h-4 mr-1"></i>高级筛选</button>
                    <div class="ml-auto flex items-center gap-2">
                        <span class="px-2 py-0.5 rounded bg-red-50 text-red-600 text-xs">强校验差异 42</span>
                        <span class="px-2 py-0.5 rounded bg-amber-50 text-amber-600 text-xs">提示差异 137</span>
                    </div>
                </div>
                <!-- 高级筛选 -->
                <div id="advanced-filter-panel" class="hidden bg-gray-50 border border-gray-200 rounded-md p-4 mb-4 grid grid-cols-1 md:grid-cols-4 gap-3">
                    <div><label class="block text-xs text-gray-500 mb-1">差异类型</label><select class="w-full px-2 py-1.5 border border-gray-300 rounded-md text-sm"><option>全部</option><option>金额不一致</option><option>数量不一致</option><option>单边缺失</option></select></div>
                    <div><label class="block text-xs text-gray-500 mb-1">校验级别</label><select class="w-full px-2 py-1.5 border border-gray-300 rounded-md text-sm"><option>全部</option><option>强校验(STRICT)</option><option>仅提示(WARN)</option></select></div>
                    <div><label class="block text-xs text-gray-500 mb-1">处理状态</label><select class="w-full px-2 py-1.5 border border-gray-300 rounded-md text-sm"><option>全部</option><option>待处理</option><option>处理中</option><option>已闭环</option><option>已忽略</option></select></div>
                    <div><label class="block text-xs text-gray-500 mb-1">对账期间</label><input type="text" value="2026-05" class="w-full px-2 py-1.5 border border-gray-300 rounded-md text-sm"></div>
                </div>
                <!-- 差异表格 -->
                <div class="overflow-x-auto">
                    <table class="min-w-full">
                        <thead class="bg-gray-50">
                            <tr>
                                <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">差异编号</th>
                                <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">对账场景</th>
                                <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">差异维度</th>
                                <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">校验级别</th>
                                <th class="px-4 py-2 text-right text-xs font-medium text-gray-500 uppercase">A 侧值</th>
                                <th class="px-4 py-2 text-right text-xs font-medium text-gray-500 uppercase">B 侧值</th>
                                <th class="px-4 py-2 text-right text-xs font-medium text-gray-500 uppercase">差异额</th>
                                <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">责任人</th>
                                <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">状态</th>
                                <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">操作</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-200">
                            <tr class="hover:bg-gray-50">
                                <td class="px-4 py-3 text-sm text-gray-800">DIFF-20260531-0012</td>
                                <td class="px-4 py-3 text-sm text-gray-600">R-006 采购订单对账</td>
                                <td class="px-4 py-3 text-sm text-gray-600">价税合计</td>
                                <td class="px-4 py-3 text-sm"><span class="px-2 py-0.5 rounded bg-red-50 text-red-600 text-xs">强校验</span></td>
                                <td class="px-4 py-3 text-sm text-right text-gray-800">12,600.00</td>
                                <td class="px-4 py-3 text-sm text-right text-gray-800">12,580.00</td>
                                <td class="px-4 py-3 text-sm text-right text-red-600 font-medium">+20.00</td>
                                <td class="px-4 py-3 text-sm text-gray-600">采购-张伟</td>
                                <td class="px-4 py-3 text-sm"><span class="px-2 py-0.5 rounded bg-orange-50 text-orange-600 text-xs">待处理</span></td>
                                <td class="px-4 py-3 text-sm space-x-2"><a href="reconciliation-diff-detail.html" class="text-primary hover:underline">处理</a><a href="reconciliation-diff-detail.html" class="text-gray-400 hover:underline">明细</a></td>
                       </tr>
                            <tr class="hover:bg-gray-50">
                                <td class="px-4 py-3 text-sm text-gray-800">DIFF-20260531-0027</td>
                                <td class="px-4 py-3 text-sm text-gray-600">R-006 采购订单对账</td>
                                <td class="px-4 py-3 text-sm text-gray-600">单边缺失（B 侧无）</td>
                                <td class="px-4 py-3 text-sm"><span class="px-2 py-0.5 rounded bg-red-50 text-red-600 text-xs">强校验</span></td>
                                <td class="px-4 py-3 text-sm text-right text-gray-800">8,900.00</td>
                                <td class="px-4 py-3 text-sm text-right text-gray-400">—</td>
                                <td class="px-4 py-3 text-sm text-right text-red-600 font-medium">+8,900.00</td>
                                <td class="px-4 py-3 text-sm text-gray-600">集成-李娜</td>
                                <td class="px-4 py-3 text-sm"><span class="px-2 py-0.5 rounded bg-blue-50 text-blue-600 text-xs">处理中</span></td>
                                <td class="px-4 py-3 text-sm space-x-2"><a href="reconciliation-diff-detail.html" class="text-primary hover:underline">处理</a><a href="reconciliation-diff-detail.html" class="text-gray-400 hover:underline">明细</a></td>
                            </tr>
                            <tr class="hover:bg-gray-50 bg-amber-50/30">
                                <td class="px-4 py-3 text-sm text-gray-800">DIFF-20260531-0104</td>
                                <td class="px-4 py-3 text-sm text-gray-600">R-006 采购订单对账</td>
                              <td class="px-4 py-3 text-sm text-gray-600">供应商名称</td>
                                <td class="px-4 py-3 text-sm"><span class="px-2 py-0.5 rounded bg-amber-50 text-amber-600 text-xs">仅提示</span></td>
                                <td class="px-4 py-3 text-sm text-right text-gray-800">星辉建材</td>
                                <td class="px-4 py-3 text-sm text-right text-gray-800">星辉建材有限公司</td>
                                <td class="px-4 py-3 text-sm text-right text-gray-400">—</td>
                                <td class="px-4 py-3 text-sm text-gray-600">—</td>
                                <td class="px-4 py-3 text-sm"><span class="px-2 py-0.5 rounded bg-gray-100 text-gray-500 text-xs">已标记</span></td>
                                <td class="px-4 py-3 text-sm space-x-2"><button class="text-gray-400 hover:underline">忽略</button><a href="reconciliation-diff-detail.html" class="text-gray-400 hover:underline">明细</a></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <p class="text-xs text-gray-500 mt-3">强校验差异未闭环将阻断对应期间结账；提示差异不阻断，可批量标记忽略。对账中心不生成差异单/调整单，处理动作包含：认领、跟进备注、退回来源系统修正、责任人转派、标记已解决——实际修复在源系统完成后回写状态。</p>
            </div>
        </main>
    </div>

    <script>
        function loadSidebar() {
            fetch('common/sidebar.html')
                .then(function (res) { return res.text(); })
                .then(function (html) {
                    document.getElementById('sidebar-container').innerHTML = html;
                    var s = document.createElement('script');
                    s.src = 'common/scripts.js';
                    s.onload = function () {
                        if (window.initCommonFunctions) window.initCommonFunctions('reconciliation-diff.html');
                        if (window.lucide) lucide.createIcons();
                    };
                    document.body.appendChild(s);
                });
        }
        // 高级筛选折叠 + 筛选维度联动 placeholder
        function initFilters() {
            var btn = document.getElementById('advanced-filter-btn');
            var panel = document.getElementById('advanced-filter-panel');
            if (btn && panel) btn.addEventListener('click', function () { panel.classList.toggle('hidden'); });
            var sel = document.getElementById('filter-select');
            var input = document.getElementById('filter-input');
            var ph = { diffNo: '请输入差异编号', ruleNo: '请输入规则编号', scene: '请输入对账场景', owner: '请输入责任人' };
            if (sel && input) sel.addEventListener('change', function () { input.placeholder = ph[sel.value] || '请输入'; });
        }
        document.addEventListener('DOMContentLoaded', function () {
            loadSidebar();
            initFilters();
            if (window.lucide) lucide.createIcons();
        });
    </script>
    <link rel="stylesheet" href="common/prd-viewer.css">
    <script src="common/prd-viewer.js"></script>
</body>
</html>